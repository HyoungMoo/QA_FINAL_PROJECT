# 이 파일은 팀원이 로컬 .env 파일을 만들 때 참고하는 샘플입니다.
# 실제 token, cookie, password 값은 이 파일에 넣지 않습니다.
# 이 파일을 복사해서 .env를 만든 뒤, 각자 로컬에서 실제 값을 채웁니다.

CLASSROOM_BASE_URL=https://api-classroom.elice.io
REST_BASE_URL=https://api-rest.elice.io
COURSE_BASE_URL=https://api-course.elice.io
ORG_NAME=
CLASSROOM_ID=
COURSE_ID=
STUDENT_TOKEN=
TEACHER_TOKEN=
REQUEST_TIMEOUT_SECONDS=10
MIN_REQUEST_INTERVAL_SECONDS=0.3
