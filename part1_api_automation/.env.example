# 이 파일은 팀원이 로컬 .env 파일을 만들 때 참고하는 샘플입니다.
# 실제 token, cookie, password 값은 이 파일에 넣지 않습니다.
# 이 파일을 복사해서 .env를 만든 뒤, 각자 로컬에서 실제 값을 채웁니다.

# 메인 API 서버 주소
base_rest_url=https://api-rest.elice.io
# 클래스 API 서버 주소
base_classroom_url=https://api-classroom.elice.io
# 강의/학습 API 서버 주소
base_course_url=https://api-course.elice.io
# 대시보드 API 서버 주소
base_dashboard_url=https://api-dashboard.elice.io

# QA 트랙 조직명
org=qatrack

# QA 트랙 4기 반 ID
classroom_id=
# 수강생 ID
student_id=
# 1주차 과목 ID
week1_course_id=
# 1주차 과목 섹션 ID
week1_course_section_id=
# 강의자료(PDF) 타입 값
lecture_material_type=3
# 1주차 2번 강의 ID
week1_2lecture_id=
# 1주차 2번 강의자료 페이지 ID
week1_2lecture_page_id=
# 1주차 2번 강의자료 ID
week1_2lecture_material_id=
# 퀴즈 타입 값
lecture_quiz_material_type=5
# 1주차 2번 강의 1번 퀴즈 페이지 ID
week1_2lecture_1quiz_page_id=
# 1주차 2번 강의 1번 퀴즈 자료 ID
week1_2lecture_1quiz_material_id=
# 코딩 실습 타입 값
lecture_exercise_material_type=4
# 1주차 2번 강의 1번 코딩 실습 페이지 ID
week1_2lecture_1exercise_page_id=
# 1주차 2번 강의 1번 코딩 실습 자료 ID
week1_2lecture_1exercise_material_id=
# 1주차 2번 강의 1번 코딩 실습 작업 공간 ID
week1_2lecture_1exercise_room_id=

# 로그인 인증 토큰
token=

request_timeout_seconds=10
min_request_interval_seconds=0.3
