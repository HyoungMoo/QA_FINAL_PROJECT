# Local environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache and test cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local editor / OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime reports generated locally
reports/*
!reports/.gitkeep
**/reports/*
!**/reports/.gitkeep

# Part 2 raw load-test data
# Keep folder structure with .gitkeep, but do not upload raw logs.
part2_load_analysis/data/00_raw_data/**
!part2_load_analysis/data/00_raw_data/
!part2_load_analysis/data/00_raw_data/**/
!part2_load_analysis/data/00_raw_data/**/.gitkeep

# Part 2 generated preprocessing outputs
# These files are recreated by part2_load_analysis/analysis/load_test_analysis.py.
part2_load_analysis/data/01_sanitized_data/**
!part2_load_analysis/data/01_sanitized_data/
!part2_load_analysis/data/01_sanitized_data/**/
!part2_load_analysis/data/01_sanitized_data/**/.gitkeep

part2_load_analysis/data/02_common_schema_data/**
!part2_load_analysis/data/02_common_schema_data/
!part2_load_analysis/data/02_common_schema_data/**/
!part2_load_analysis/data/02_common_schema_data/**/.gitkeep

part2_load_analysis/data/03_analysis_ready_data/**
!part2_load_analysis/data/03_analysis_ready_data/
!part2_load_analysis/data/03_analysis_ready_data/**/
!part2_load_analysis/data/03_analysis_ready_data/**/.gitkeep
