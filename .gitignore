# 로컬 환경 변수 파일에는 토큰, 쿠키, 비밀번호, ID 등 민감 정보가 들어갈 수 있으므로 제외
.env

# Python 캐시 파일 : 로컬에서 자동 생성되므로 제외
__pycache__/
*.py[cod]
.pytest_cache/

# 가상환경 폴더 제외
.venv/
venv/

# 테스트/리포트 결과물은 실행 시 생성되는 산출물이므로 제외
# 폴더 구조 유지를 위해 .gitkeep만 유지
**/reports/*
!**/reports/.gitkeep

# 제공받은 부하 테스트 원본 로그는 초기 push 대상에서 제외
# 폴더 구조 유지를 위해 .gitkeep만 유지
part2_load_analysis/data/team2_results/*
!part2_load_analysis/data/team2_results/.gitkeep

part2_load_analysis/data/team3_results/*
!part2_load_analysis/data/team3_results/.gitkeep