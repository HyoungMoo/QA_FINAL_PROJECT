# Local environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache and test cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local editor / OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime reports generated locally
reports/*
!reports/.gitkeep
!reports/**/
!reports/**/.gitkeep
**/reports/*
!**/reports/.gitkeep
!**/reports/**/
!**/reports/**/.gitkeep

